# Service systemd du backend NestJS SmartFarm (pont vers l'API Flask « edge_ai »).
# À adapter : User, WorkingDirectory et le chemin de node (commande `which node`) selon votre Raspberry Pi.
#
# Installation :
#   sudo cp smartfarm-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now smartfarm-backend
# Suivi :
#   systemctl status smartfarm-backend
#   journalctl -u smartfarm-backend -f

[Unit]
Description=SmartFarm backend NestJS (pont vers l'API edge)
# Démarre après le réseau et après l'API Flask « edge_ai ». Adaptez le nom du service Flask (smartfarm-edge.service ici).
After=network.target smartfarm-edge.service
Wants=smartfarm-edge.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smartfarm/backend
EnvironmentFile=-/home/pi/smartfarm/backend/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
