# Copier en .env (ignoré par git) et adapter. Chaque variable a une valeur par défaut.

# Port du backend NestJS (écoute sur 0.0.0.0 : le téléphone, relié par le hotspot, doit pouvoir le joindre).
PORT=3000

# Adresse de l'API Flask « edge_ai » du Raspberry Pi.
EDGE_API_URL=http://127.0.0.1:5000

# Délai maximal d'un appel à Flask, en millisecondes (les capteurs DHT et ultrason peuvent être lents).
EDGE_TIMEOUT_MS=5000
